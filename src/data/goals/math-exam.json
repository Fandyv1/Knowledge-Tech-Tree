    {
      "id": "functions-limits",
      "title": "函数与极限",
      "category": "calc",
      "summary": "函数性质、数列极限、连续与间断点，整个高数的地基。",
      "why": "极限定义导数、积分与级数，概念不清后面只能套公式。",
      "description": [
        "极限研究「无限接近」：数列极限、函数极限、左右极限与无穷小。要能用定义证明简单极限，也要熟练等价无穷小、夹逼与单调有界准则。",
        "连续与间断点分类是极限的直接应用，也是后面判断可导、可积的前提。很多证明题的第一步都是把式子整理成极限形式。"
      ],
      "purposes": [
        "建立极限的严格定义与直觉",
        "判断函数连续性与间断类型",
        "为导数、积分、级数打基础"
      ],
      "resources": [
        {
          "title": "3Blue1Brown: 微积分本质",
          "type": "video",
          "url": "https://www.3blue1brown.com/topics/calculus"
        },
        {
          "title": "MIT 18.01 单变量微积分",
          "type": "course",
          "url": "https://ocw.mit.edu/courses/18-01sc-single-variable-calculus-fall-2010/"
        }
      ],
      "zhihuKeywords": [
        "数列极限 定义",
        "等价无穷小 替换"
      ],
      "prerequisites": []
    },
    {
      "id": "derivatives",
      "title": "导数与微分",
      "category": "calc",
      "summary": "导数定义、求导法则、高阶导数与微分。",
      "why": "导数刻画变化率，是极值、中值定理与微积分应用的核心。",
      "description": [
        "导数本质是差商的极限。要掌握基本求导公式、四则运算、复合函数链式法则、隐函数与参数方程求导。",
        "微分是函数增量的线性主部，也是近似计算与误差估计的工具。做题时要分清「可导」「连续」「可微」之间的推出关系。"
      ],
      "purposes": [
        "熟练计算各类函数的导数",
        "理解可导与连续的关系",
        "为极值、中值定理与积分打基础"
      ],
      "resources": [
        {
          "title": "Khan Academy: 导数",
          "type": "course",
          "url": "https://www.khanacademy.org/math/calculus-1"
        },
        {
          "title": "MIT 18.01 导数与微分",
          "type": "course",
          "url": "https://ocw.mit.edu/courses/18-01sc-single-variable-calculus-fall-2010/"
        }
      ],
      "zhihuKeywords": [
        "隐函数 求导"
      ],
      "prerequisites": [
        "functions-limits"
      ]
    },
    {
      "id": "mean-value",
      "title": "中值定理",
      "category": "calc",
      "summary": "罗尔、拉格朗日、柯西中值定理与不等式证明。",
      "why": "证明题的高频考点，也是把函数值与导数联系起来的桥梁。",
      "description": [
        "三大中值定理层层递进：罗尔定理是基础，拉格朗日把差商等于某点导数，柯西处理两个函数的比。证明题常要构造辅助函数。",
        "常见题型包括证明存在 ξ 满足某等式、证明不等式、讨论根的个数。看到「存在一点」就要条件反射地想到中值定理。"
      ],
      "purposes": [
        "掌握中值定理的条件与结论",
        "学会构造辅助函数",
        "应对证明题与不等式题"
      ],
      "resources": [
        {
          "title": "MIT 18.01: 中值定理",
          "type": "course",
          "url": "https://ocw.mit.edu/courses/18-01sc-single-variable-calculus-fall-2010/"
        },
        {
          "title": "Khan Academy: 中值定理",
          "type": "course",
          "url": "https://www.khanacademy.org/math/ap-calculus-ab/ab-diff-analytical-applications-new"
        }
      ],
      "zhihuKeywords": [
        "拉格朗日中值定理 构造"
      ],
      "prerequisites": [
        "derivatives"
      ]
    },
    {
      "id": "indefinite-integral",
      "title": "不定积分",
      "category": "calc",
      "summary": "原函数、换元积分、分部积分与常见积分表。",
      "why": "积分是导数的逆运算，也是定积分、微分方程的前置。",
      "description": [
        "不定积分求全体原函数。核心方法是换元与分部：第一类换元凑微分，第二类换元处理根式，分部积分处理乘积。",
        "要背熟基本积分表，并理解「凑」的方向来自求导法则的逆用。积分结果别忘加常数 C，这是最容易丢的分。"
      ],
      "purposes": [
        "熟练计算常见不定积分",
        "掌握换元与分部积分",
        "为定积分与微分方程做准备"
      ],
      "resources": [
        {
          "title": "3Blue1Brown: 积分",
          "type": "video",
          "url": "https://www.3blue1brown.com/topics/calculus"
        },
        {
          "title": "Khan Academy: 积分",
          "type": "course",
          "url": "https://www.khanacademy.org/math/integral-calculus"
        }
      ],
      "zhihuKeywords": [
        "分部积分 口诀"
      ],
      "prerequisites": [
        "derivatives"
      ]
    },
    {
      "id": "definite-integral",
      "title": "定积分与应用",
      "category": "calc",
      "summary": "定积分性质、变上限积分、面积与旋转体体积。",
      "why": "定积分把「累积」变成可计算量，应用题几乎每年必考。",
      "description": [
        "定积分是黎曼和的极限，性质包括线性、区间可加、保号与估值。变上限积分函数把积分与求导连起来，是证明题的常用工具。",
        "应用集中在几何与物理：面积、弧长、旋转体体积、功与平均値。做题要先把图形画出来，再决定对 x 还是对 y 积分。"
      ],
      "purposes": [
        "掌握定积分的性质与计算",
        "处理变上限积分求导",
        "解决面积、体积等应用题"
      ],
      "resources": [
        {
          "title": "MIT 18.01: 定积分与应用",
          "type": "course",
          "url": "https://ocw.mit.edu/courses/18-01sc-single-variable-calculus-fall-2010/"
        },
        {
          "title": "Khan Academy: 定积分",
          "type": "course",
          "url": "https://www.khanacademy.org/math/integral-calculus"
        }
      ],
      "zhihuKeywords": [
        "变上限积分 求导"
      ],
      "prerequisites": [
        "indefinite-integral",
        "mean-value"
      ]
    },
